<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootOverlayContainer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:padding="6dp">

    <!-- ========================================================= -->
    <!-- 1. EXPANDED WAQT GLASS FLOATING CARD                      -->
    <!-- ========================================================= -->
    <LinearLayout
        android:id="@+id/cardExpandedContainer"
        android:layout_width="332dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card"
        android:elevation="16dp"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header: Badge + Brand Mark + Minimize (_) + Close (X) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="🌱 Daily Habit"
                android:textColor="#35B6AD"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBrandMark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="WAQT"
                android:textColor="#FFAA6B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Minimize Button (_) -->
            <TextView
                android:id="@+id/btnMinimize"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_glass_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="—"
                android:textColor="#F5F5F0"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Close / Complete Button (X) -->
            <TextView
                android:id="@+id/btnClose"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_glass_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="✕"
                android:textColor="#F16D68"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Task / Habit Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:shadowColor="#80101827"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:text="Focus &amp; Deep Work Session"
            android:textColor="#F5F5F0"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Subtitle / Due Time -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Due now • Tap (✕) to complete"
            android:textColor="#B3F5F5F0"
            android:textSize="12sp" />

        <!-- Habit Streak Section (Visible for Habits) -->
        <LinearLayout
            android:id="@+id/habitStreakContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvStreakCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔥 5-day streak"
                    android:textColor="#FFAA6B"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStreakGoal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5 / 7 days"
                    android:textColor="#35B6AD"
                    android:textSize="12sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressHabitStreak"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_marginTop="8dp"
                android:max="7"
                android:progress="5"
                android:progressBackgroundTint="#26FFFFFF"
                android:progressTint="#FFAA6B" />
        </LinearLayout>

        <!-- Action Row (Pomodoro + Snooze) -->
        <LinearLayout
            android:id="@+id/actionButtonsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnStartPomodoro"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1.3"
                android:background="@drawable/bg_glass_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="🍅 Start 25m"
                android:textColor="#35B6AD"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSnooze"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="💤 10m"
                android:textColor="#F5F5F0"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Live Pomodoro Section Inside Floating Card -->
        <LinearLayout
            android:id="@+id/pomodoroActiveContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPomodoroStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🍅 Focus Session"
                    android:textColor="#35B6AD"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPomodoroTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="25:00"
                    android:textColor="#F5F5F0"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressPomodoro"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="8dp"
                android:max="1500"
                android:progress="1500"
                android:progressBackgroundTint="#26FFFFFF"
                android:progressTint="#35B6AD" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnPauseResumePomodoro"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_glass_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="⏸ Pause"
                    android:textColor="#F5F5F0"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnStopPomodoro"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_glass_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="⏹ Stop"
                    android:textColor="#F16D68"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- ========================================================= -->
    <!-- 2. MINIMIZED FLOATING GLASS BUBBLE (EDGE COLLAPSED STATE) -->
    <!-- ========================================================= -->
    <LinearLayout
        android:id="@+id/bubbleMinimizedContainer"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:background="@drawable/bg_glass_card"
        android:elevation="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:visibility="gone"
        tools:visibility="gone">

        <TextView
            android:id="@+id/tvBubbleIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🍅"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvBubbleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="monospace"
            android:text="25:00"
            android:textColor="#F5F5F0"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
